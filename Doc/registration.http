@baseUrl=https://localhost:7111
@apiKey=74501e8e4b6bcb7616790ed515c45250

### List registered anchors
GET {{baseUrl}}/api/anchors
Content-Type: application/json
X-Api-Key: {{apiKey}}

### Register a new anchor
# Provide the DigitalLink anchor, the company prefix and the description of the product/anchor
POST {{baseUrl}}/api/anchors
Content-Type: application/json
X-Api-Key: {{apiKey}}
{
  "prefix": "01/05414196535263",
  "description": "Product description"
}

### Get details of an anchor
GET {{baseUrl}}/api/anchors/qTFrufVwob
Content-Type: application/json
X-Api-Key: {{apiKey}}

### Register a link for a specific anchor
POST {{baseUrl}}/api/anchors/qTFrufVwob/links
Content-Type: application/json
X-Api-Key: {{apiKey}}
{
  "type": "gs1:homepage",
  "redirectUrl": "https://goto.it.com/en",
  "title": "Company homepage",
  "languages": [ "en" ],
  "mediaType": "text/html",
  "isDefault": true
}

### Remove a link from an anchor
DELETE {{baseUrl}}/api/anchors/qTFrufVwob/links/HpSATmuEMA
Content-Type: application/json
X-Api-Key: {{apiKey}}
@baseUrl=https://localhost:7111
@apiKey=sk_HxtRNQ1ZgyGBpNuAAKeJpIvQ4SOUlvNL

### List registered anchors
GET {{baseUrl}}/api/anchors
Content-Type: application/json
X-Api-Key: {{apiKey}}

### Register a new anchor
# Provide the DigitalLink anchor, the company prefix and the description of the product/anchor
POST {{baseUrl}}/api/anchors
Content-Type: application/json
X-Api-Key: {{apiKey}}
{
  "prefix": "01/05414195535264",
  "companyPrefix": "5414195",
  "description": "Product description"
}

### Get details of an anchor
GET {{baseUrl}}/api/anchors/UkLWZg9DAJ
Content-Type: application/json
X-Api-Key: {{apiKey}}

### Register a link for a specific anchor
POST {{baseUrl}}/api/anchors/UkLWZg9DAJ/links
Content-Type: application/json
X-Api-Key: {{apiKey}}
{
  "linkType": "gs1:consumerHandlingStorageInfo",
  "redirectUrl": "https://goto.it.com/my-product/how-to-handle",
  "title": "Informations sur la manipulation/stockage",
  "languages": [ "fr" ],
  "mediaType": "text/html",
  "isDefault": true
}

### Remove a link from an anchor
DELETE {{baseUrl}}/api/anchors/UkLWZg9DAJ/links/kQKMTKyEQA
Content-Type: application/json
X-Api-Key: {{apiKey}}
@using Gs1DigitalLink.Web.Contracts
@using Gs1DigitalLink.Web.Services
@inject CommonLocalizationService Localizer
@model GS1ResolverResult
@{
    Layout = "_Layout";
    ViewData["Title"] = "Metadata";
}

<h2>@Localizer[Model.Name]</h2>

<h3>Liste des identifiants supportés</h3>
<p>
    @foreach(var key in Model.SupportedPrimaryKeys)
    {
        <span class="tag linkType">@key</span>
    }
</p>

<h3>Lien racine du résolveur :</h3>
<p><a href="@Model.ResolverRoot" target="_blank">@Model.ResolverRoot</a></p>

<h3>Contact :</h3>
<p>@Model.Contact.Fn</p>
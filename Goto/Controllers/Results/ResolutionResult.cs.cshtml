@using Goto.Services.Translations
@model Goto.Controllers.Results.ResolutionResult
@inject CommonLocalizationService Localizer
@{
    Layout = "_Shared";
    ViewData["Title"] = Localizer["Multiple choices available"];

    string GetCountryName(string language)
    {
        var culture = System.Globalization.CultureInfo.GetCultureInfoByIetfLanguageTag(language);

        return culture.DisplayName;
    }
}

<h1>@Localizer["Multiple links are available for this resource"]</h1>


<header>
    <h2>@Localizer["Links for Anchor"] @Model.Description</h2>
    <p class="anchor">@Model.Anchor</p>
</header>
<section>
    @foreach(var link in Model.Links)
    {
        <dl>
            <dt>@Localizer["Link"]</dt>
            <dd><a href="@link.Href" title="@link.Href" target="_blank">@link.Href</a></dd>

            <dt>@Localizer["Title"]</dt>
            <dd>@link.Title</dd>

            <dt>@Localizer["Language(s)"]</dt>
            <dd>
                @foreach (var lang in link.Hreflang)
                {
                    <span class="tag language" title="@lang">@GetCountryName(lang)</span>
                }
            </dd>

            <dt>@Localizer["Media Type"]</dt>
            <dd>@link.Type</dd>
        </dl>
    }
</section>
@using Goto.Translations
@model Goto.Controllers.Results.LinksetResult
@inject CommonLocalizationService Localizer
@{
    Layout = "_Shared";
    ViewData["Title"] = Localizer["Linkset"];
    var i = 0;

    string GetCountryName(string language)
    {
        var culture = System.Globalization.CultureInfo.GetCultureInfoByIetfLanguageTag(language);

        return culture.DisplayName;
    }

    string DetailStatus()
    {
        return i++ == 0 
            ? "open" 
            : string.Empty;
    }
}

<h2>@Localizer["Linkset for this resource"]</h2>

@foreach (var linkset in Model.Anchors)
{
    var anchorLinks = linkset.Links.GroupBy(l => new { l.Href, l.Title });

    <details name="anchor" @DetailStatus()>
        <summary>@Localizer["Links for Anchor"] <code>@linkset.Anchor</code></summary>

        <ul>
            @foreach (var link in anchorLinks)
            {
                <li>
                    <a href="@link.Key.Href" title="@link.Key.Href" target="_blank">@link.Key.Title</a>
                    @if(link.Any(l => l.IsDefault))
                    {
                        <span class="tag defaultLink">@Localizer["gs1:defaultLink"]</span>
                    }
                    @foreach (var linkType in link.Select(l => l.LinkType).Distinct())
                    {
                        <span class="tag linkType">@Localizer[linkType]</span>
                    }
                    @foreach (var lang in link.SelectMany(l => l.Hreflang).Distinct())
                    {
                        <span class="tag language">@GetCountryName(lang)</span>
                    }
                </li>
            }
        </ul>
    </details>
}

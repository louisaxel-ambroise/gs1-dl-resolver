@using System.Globalization
@using Gs1DigitalLink.Web.Services
@inject CommonLocalizationService Localizer
@{
    var direction = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft
                ? "rtl"
                : "ltr";
}
<!DOCTYPE html>
<html dir="@direction">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/png" href="https://goto.it.com/favicon.ico">
        <title>@ViewData["Title"] - Goto.it.com</title>
        <style>
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

  :root {
    --bg: #f4f4f5;
    --surface: #ffffff;
    --text: #141414;
    --subtle: #666;
    --primary: #005fcc;
    --tag-lang: #111;
    --tag-type: #133c85;
    --tag-default: #006f24;
    --radius: 8px;
    --shadow: 0 4px 12px rgba(0,0,0,0.08);
    font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
  }

  @@media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f0f10;
      --surface: #1b1b1d;
      --text: #ededed;
      --subtle: #aaa;
      --primary: #7ab8ff;
      --tag-lang: #ededed;
      --tag-type: #6eaefb;
      --tag-default: #4ad07c;
      --shadow: 0 4px 12px rgba(255,255,255,0.08);
    }
  }

  [data-theme="dark"] {
      --bg: #f4f4f5;
      --surface: #ffffff;
      --text: #141414;
      --subtle: #666;
      --primary: #005fcc;
      --tag-lang: #111;
      --tag-type: #133c85;
      --tag-default: #006f24;
      --radius: 8px;
      --shadow: 0 4px 12px rgba(0,0,0,0.08);
  }

  [data-theme="light"] {
      --bg: #0f0f10;
      --surface: #1b1b1d;
      --text: #ededed;
      --subtle: #aaa;
      --primary: #7ab8ff;
      --tag-lang: #ededed;
      --tag-type: #7ab8ff;
      --tag-default: #4ad07c;
      --shadow: 0 4px 12px rgba(255,255,255,0.08);
  }

  body {
    background: var(--bg);
    color: var(--text);
    max-width: 1050px;
    padding: 4vh 4vw;
    margin: auto;
  }

  .logo {
    font-weight: 700;
    margin-bottom: 20px;
    display: inline-block;
    background: var(--text);
    color: var(--bg);
    border-radius: 10px;
    padding: 1px 10px;
    margin-right: 4px;
    line-height: 35px;
    text-transform: uppercase;
    font-size: 22px;
    letter-spacing: 0px;
  }

  /* Container */
  .content {
    background: var(--surface);
    border-radius: var(--radius);
    padding: 24px;
    line-height: 1.55;
  }

  .content h2 {
    text-align: center;
    margin-bottom: 16px;
    font-size: 20px;
    font-weight: 600;
  }

  .content ul { list-style: none; }
  .content li {
    padding: 12px 8px;
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }
  @@media (prefers-color-scheme: dark) {
    .content li { border-bottom: 1px solid rgba(255,255,255,0.08); }
  }

  .content li:last-child { border-bottom: none; }

  a {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
  }
  a:hover { text-decoration: underline; }

  .tag {
    display: inline-block;
    margin-left: 6px;
    padding: 3px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: .3px;
    color: var(--surface);
  }
  .language { background: var(--tag-lang); color: var(--bg); }
  .linkType { background: var(--tag-type); }
  .defaultLink { background: var(--tag-default); }

  details { margin:20px; }
  .content details ul li { padding-left:30px; }

  footer {
    color: var(--subtle);
    text-align: center;
    margin-top: 25px;
    font-size: 14px;
  }
  footer a {
    color: var(--subtle);
  }
  footer a:hover { color: var(--primary); }
        </style>
    </head>
    <body>
        <h1 class="logo">Goto</h1>
        <div class="content">
            @RenderBody()
        </div>
        <footer>
            <p>&copy; @TimeProvider.System.GetUtcNow().Year Goto.it.com</p>
            <p><a href="https://goto.it.com/">@Localizer["Home"]</a></p>
            <p>@Localizer["Theme:"]
                <a href="#" id="themeToggle" aria-label="Toggle theme">
                    <span class="theme-icon light-icon">@Localizer["Light"]</span>
                    <span class="theme-icon dark-icon">@Localizer["Dark"]</span>
                </a>
            </p>
        </footer>
        <script type="text/javascript">
            function getTheme() {
              const savedTheme = localStorage.getItem('theme');
              if (savedTheme) {
                return savedTheme;
              }

              return window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
            }

            function setTheme(theme) {
              document.documentElement.setAttribute('data-theme', theme);
              localStorage.setItem('theme', theme);

              updateThemeToggle(theme);
            }

            function toggleTheme(e) {
              const currentTheme = getTheme();
              setTheme(currentTheme === 'dark' ? 'light' : 'dark');

              e.preventDefault();
            }

            function updateThemeToggle(theme) {
              const lightIcon = document.querySelector('.light-icon');
              const darkIcon = document.querySelector('.dark-icon');

              if (theme === 'dark') {
                lightIcon.style.display = 'none';
                darkIcon.style.display = 'inline';
              } else {
                lightIcon.style.display = 'inline';
                darkIcon.style.display = 'none';
              }
            }

            document.addEventListener('DOMContentLoaded', () => {
              const theme = getTheme();
              const toggle = document.getElementById('themeToggle');

              setTheme(theme);
              toggle.addEventListener('click', toggleTheme);
            });
        </script>
    </body>
</html>
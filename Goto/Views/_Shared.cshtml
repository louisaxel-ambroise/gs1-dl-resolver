@using System.Globalization
@using Goto.Translations
@inject CommonLocalizationService localizer
@{
    var direction = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft
                ? "rtl"
                : "ltr";
    var marginDir = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft
                ? "left"
                : "right";
}
<!DOCTYPE html>
<html dir="@direction">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/png" href="/favicon.ico">
        <link rel="stylesheet" type="text/css" href="/default.css">
        <title>@ViewData["Title"] - Goto.it.com</title>
    </head>
    <body>
        <div class="content">
            @RenderBody()
        </div>
        <footer>
            <p>&copy; @DateTimeOffset.UtcNow.Year Goto.it.com</p>
            <p><a href="https://goto.it.com/">@localizer["Home"]</a></p>
            <p>
                @localizer["Theme:"]
                <a href="#" id="themeToggle" aria-label="Toggle theme">
                <span class="theme-icon light-icon">@localizer["Light"]</span>
                <span class="theme-icon dark-icon">@localizer["Dark"]</span>
                </a>
            </p>
        </footer>
        <script type="text/javascript" src="/script.js" defer></script>
    </body>
</html>